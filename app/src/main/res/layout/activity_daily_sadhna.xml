<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F2"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="serif"
            android:text="Daily Sadhna Entry"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="18dp"
            android:text="Record your daily devotional practices"
            android:textColor="#555555"
            android:textSize="13sp" />

        <!-- 1. DATE & TIME SCHEDULE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_white_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="⏰ Schedule &amp; Timings"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- DATE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field_light"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Select Date (DD/MM/YYYY)"
                android:inputType="none"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="14sp" />

            <!-- WAKE UP TIME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wake Up Time"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etWakeUpTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field_light"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Select Wake Up Time"
                android:inputType="none"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 2. JAPA & CHANTING CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_white_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="📿 Japa &amp; Holy Name"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- JAPA ROUNDS COUNTER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Japa Rounds Completed"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnJapaMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#E65100"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvJapaCount"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#111111"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnJapaPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#E65100"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Rounds"
                    android:textColor="#616161"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- FINISH TIME OF JAPA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finish Time of Japa"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etJapaFinishTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field_light"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Select Finish Time of Japa"
                android:inputType="none"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 3. TEMPLE & MORNING PROGRAMS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_white_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="🪷 Spiritual Activities Attended"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbMangalAarti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Mangal Aarti — मंगल आरती"
                android:textColor="#111111"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbNarasimhaAarti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Narasimha Aarti — नरसिंह आरती"
                android:textColor="#111111"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbTulsiAarti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Tulsi Aarti — तुलसी आरती"
                android:textColor="#111111"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbShringarAarti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Shringar Aarti — शृंगार आरती"
                android:textColor="#111111"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbGuruPuja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Guru Puja — गुरु पूजा"
                android:textColor="#111111"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbSrimadBhagvatam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Srimad Bhagvatam — श्रीमद भागवतम्"
                android:textColor="#111111"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbSatsang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Satsang Program — सत्संग कार्यक्रम"
                android:textColor="#111111"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 4. READING & HEARING CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_white_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="📖 Swadhyaya &amp; Shravanam"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- BOOK READING -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Reading Subject"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBookReadingSubject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_field_light"
                android:hint="e.g. Bhagavad Gita As It Is"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Reading Duration"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerBookReadingTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field_light"
                android:paddingHorizontal="12dp" />

            <!-- HEARING -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lecture / Hearing Subject"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHearingSubject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_field_light"
                android:hint="e.g. Prabhupada SB 1.2.6 Lecture"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hearing Duration"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerHearingTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field_light"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <!-- 5. PRACTICAL DEVOTIONAL SEVA CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_white_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="🌺 Practical Devotional Seva"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbSeva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Devotional Seva Performed"
                android:textColor="#111111"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layoutSevaTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seva Duration"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etSevaHours"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field_light"
                        android:enabled="false"
                        android:gravity="center"
                        android:hint="Hr"
                        android:inputType="number"
                        android:maxLength="2"
                        android:textColor="#111111"
                        android:textColorHint="#757575"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text="Hr  :"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etSevaMinutes"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field_light"
                        android:enabled="false"
                        android:gravity="center"
                        android:hint="Min"
                        android:inputType="number"
                        android:maxLength="2"
                        android:textColor="#111111"
                        android:textColorHint="#757575"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Min"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 6. SLEEPING TIME / NIGHT REST CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_white_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="🌙 Night Rest &amp; Sleeping Time"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- SLEEPING TIME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sleeping Time"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSleepingTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field_light"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Select Sleeping Time"
                android:inputType="none"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 7. SAVE BUTTON -->
        <Button
            android:id="@+id/btnSaveSadhna"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_login_gradient_btn"
            android:elevation="3dp"
            android:text="SAVE DAILY SADHNA"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
