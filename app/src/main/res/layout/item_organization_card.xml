<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardOrgContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_input_field_light"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="14dp">

    <ImageView
        android:id="@+id/ivOrgIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_flourish_lotus_amber"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvOrgItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="ISKCON Shirpur"
        android:textColor="#1F2937"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivOrgSelectedIndicator"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_check_green"
        android:visibility="gone"
        android:importantForAccessibility="no" />

</LinearLayout>
