<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRemindersLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F2">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <!-- TOP ACTION BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnBack"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="8dp"
                    android:text="← Back"
                    android:textColor="#E65100"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnTestNotification"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#FFF3E0"
                    android:minHeight="36dp"
                    android:paddingHorizontal="12dp"
                    android:text="🔔 Test Alert"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TITLE & DESCRIPTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Sadhna Reminders"
                    android:textColor="#111111"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Set specific reminder times for your daily spiritual commitments"
                    android:textColor="#555555"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- PERMISSION WARNING BANNER (shown only if permission missing) -->
            <LinearLayout
                android:id="@+id/layoutPermissionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="#FFEBEE"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚠️ Notifications are disabled. Enable to receive daily reminders."
                    android:textColor="#C62828"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnGrantPermission"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#C62828"
                    android:minHeight="32dp"
                    android:paddingHorizontal="10dp"
                    android:text="Enable"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- MASTER SWITCH CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_white_glass_card"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Daily Reminder Alerts"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Receive local notification alerts at scheduled times"
                        android:textColor="#666666"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchMaster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp" />
            </LinearLayout>

            <!-- UPCOMING REMINDER SUMMARY CARD -->
            <LinearLayout
                android:id="@+id/layoutNextReminderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:background="#FFF8E1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="⏰"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvNextReminderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Next Reminder: Morning Japa at 06:30 AM"
                    android:textColor="#E65100"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SECTION HEADER & QUICK ACTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="COMMITMENT SCHEDULE"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAddCustomReminder"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#E8F5E9"
                    android:minHeight="32dp"
                    android:paddingHorizontal="10dp"
                    android:text="+ Add Reminder"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnResetDefaults"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#F5F5F5"
                    android:minHeight="32dp"
                    android:paddingHorizontal="8dp"
                    android:text="🔄 Reset"
                    android:textColor="#616161"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- DYNAMIC LIST OF COMMITMENT REMINDERS -->
            <LinearLayout
                android:id="@+id/llCommitmentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
