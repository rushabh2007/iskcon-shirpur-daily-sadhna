<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRegisterScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F2"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="36dp">

        <!-- HEADER -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="ISKCON"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Create Account"
            android:textColor="#555555"
            android:textSize="14sp" />

        <!-- REGISTRATION FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_glass_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- SELECTED ORGANISATION BANNER -->
            <LinearLayout
                android:id="@+id/layoutRegisterOrgBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_stat_accent_sadhna"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_flourish_lotus_amber" />

                <TextView
                    android:id="@+id/tvRegisterSelectedOrgName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Organisation: ISKCON Shirpur"
                    android:textColor="#B45309"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnChangeOrgFromRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:text="Change"
                    android:textColor="#1A237E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 0. SELECT ROLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Role"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerRole"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field_light"
                android:paddingHorizontal="14dp" />

            <!-- 1. FULL NAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegisterName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field_light"
                android:hint="Enter your full name (e.g. Rahul Patil)"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="15sp" />

            <!-- 2. EMAIL ADDRESS / USERNAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email Address / Username"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field_light"
                android:hint="Enter email address"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="15sp" />

            <!-- 3. PASSWORD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field_light"
                android:hint="Enter password (min 6 characters)"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="15sp" />

            <!-- 4. CONFIRM PASSWORD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegisterConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field_light"
                android:hint="Re-enter password"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="15sp" />

            <!-- 4B. ADMIN PASSCODE (MANDATORY FOR ADMIN ROLE) -->
            <LinearLayout
                android:id="@+id/layoutAdminPasscodeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Admin Passcode"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"
                    android:text="* Mandatory authorization passcode required to register as Administrator"
                    android:textColor="#666666"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etRegisterAdminPasscode"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_field_light"
                    android:hint="Enter Admin Passcode"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="#111111"
                    android:textColorHint="#757575"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 5. SELECT CENTRE / ORGANIZATION (HIDDEN - PRESELECTED AT FIRST PAGE) -->
            <Spinner
                android:id="@+id/spinnerOrganization"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- 5. SELECT COUNSELLOR -->
            <LinearLayout
                android:id="@+id/layoutMentorSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Assigned Counsellor"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"
                    android:text="* Your daily sadhna reports will be reviewed by this counsellor."
                    android:textColor="#666666"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerMentor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_field_light"
                    android:paddingHorizontal="14dp" />
            </LinearLayout>

            <!-- STATUS / PROGRESS -->
            <TextView
                android:id="@+id/tvRegisterStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRegisterError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:textColor="#C62828"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/registerProgressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:indeterminateTint="#E65100"
                android:visibility="gone" />

            <!-- CREATE ACCOUNT BUTTON -->
            <Button
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_login_gradient_btn"
                android:elevation="3dp"
                android:text="REGISTER ACCOUNT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- BACK TO LOGIN BUTTON -->
            <Button
                android:id="@+id/btnBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_create_account_btn_light"
                android:text="ALREADY HAVE AN ACCOUNT? LOGIN"
                android:textColor="#E65100"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
